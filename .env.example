# Copy to .env.local and fill in your credentials.
# Server-side only (no VITE_ prefix). Never commit .env or .env.local.

# ==============================================================================
# 1. Payment Gateway Configuration
# ==============================================================================
# Active online gateway when both are configured: razorpay | cashfree
PAYMENT_PROVIDER=razorpay

# Razorpay (Dashboard > Account & Settings > API Keys / Webhooks)
# Webhook URL: https://<your-domain>/api/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree PG API v3 (Dashboard > Developers > API Keys)
# Webhook URL: https://<your-domain>/api/webhooks/cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
# sandbox | production
CASHFREE_ENV=production

# ==============================================================================
# 2. Shipping & Courier Configuration
# ==============================================================================
# Shiprocket (auto-authenticates and refreshes token automatically)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
PICKUP_PINCODE=600008

# Delhivery Direct (optional alternative to Shiprocket)
DELHIVERY_TOKEN=
DELHIVERY_WAREHOUSE=TranzLife Warehouse

# Shared secret for inbound courier tracking webhooks:
#   POST /api/webhooks/courier/shiprocket  or  /api/webhooks/courier/delhivery
COURIER_WEBHOOK_SECRET=

# ==============================================================================
# 3. GST Invoices & SEO Configuration
# ==============================================================================
SELLER_NAME=TranzLife Biosciences Pvt. Ltd.
SELLER_GSTIN=
SELLER_STATE=Tamil Nadu
SELLER_ADDRESS=Montieth Road, Egmore, Chennai, Tamil Nadu 600008
SITE_URL=https://www.tranzlife.in

# ==============================================================================
# 4. Database & Object Storage
# ==============================================================================
# Leave DATABASE_URL empty locally to use the built-in PGlite database (./data/pglite).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# PGSSL=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=ap-southeast-1

# ==============================================================================
# 5. Auth & Notifications (Twilio / MSG91 / Resend)
# ==============================================================================
# Random string (32+ chars) that signs customer sessions:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# SITE_ORIGIN=https://www.tranzlife.in

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=
# off | sms | whatsapp
ORDER_NOTIFICATIONS=off

# Optional transactional email alerts (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Optional MSG91 fallback for sign-in OTPs
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# ==============================================================================
# 6. Tulsi AI Chat & Server Port
# ==============================================================================
GEMINI_API_KEYS=key_1,key_2,key_3,key_4
GEMINI_MODEL=gemini-3.5-flash-lite
CHAT_MODEL=gemma2:9b
OLLAMA_URL=http://localhost:11434
PORT=3000
