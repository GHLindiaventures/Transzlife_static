# Copy to .env and fill in. Server-side only (no VITE_ prefix), never sent to the browser. Never commit .env.

# ---- Tulsi chat: Gemini (primary) ----
# Up to 4 keys, comma-separated. On a quota / rate-limit error the server rotates to the next key;
# when every key is out it switches to Ollama, and back to Gemini as soon as a key works again.
GEMINI_API_KEYS=key_1,key_2,key_3,key_4
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Tulsi chat: Ollama (fallback) ----
# Needs `ollama serve` and `ollama pull gemma2:9b` (plus `ollama pull bge-m3` for the understanding layer).
CHAT_MODEL=gemma2:9b
OLLAMA_URL=http://localhost:11434

# Port for `npm start` (production server: built site + chat API)
PORT=3000

# Only if the chat API runs on a different domain from the site:
# CHAT_ORIGIN=https://www.tranzlife.in        (on the chat server: the site allowed to call it)
# VITE_CHAT_API=https://chat.tranzlife.in     (at build time: where the site sends chat messages)

# ---- Shop backend (server/shop) ----
# PostgreSQL connection. Leave empty on your own machine to use the built-in local database
# (PGlite, stored in ./data/pglite). Required on Render; the shop API stays off without it.
DATABASE_URL=
# PGSSL=true                      # only if connecting to Postgres over the public internet
# Random string of at least 32 characters that signs sign-in codes. Required.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Extra allowed site origins for API calls, comma-separated (same-domain calls are always allowed)
# SITE_ORIGIN=https://www.tranzlife.in

# ---- Razorpay (online payments) ----
# Without these, checkout offers Cash on delivery only. Use rzp_test_ keys on staging.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL: https://<your-domain>/api/webhooks/razorpay  events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=

# ---- Twilio (sign-in codes by SMS, order updates) ----
# From console.twilio.com. Sign-in codes use Twilio Verify if TWILIO_VERIFY_SERVICE_SID is set
# (recommended: Twilio creates and checks the codes), otherwise plain SMS from the sender below.
# Check the setup with:  npm run twilio:check   (add -- --to 98XXXXXXXX to send a real test)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Sender for plain SMS (one of these):
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=
# WhatsApp-enabled sender, e.g. +14155238886 (Twilio sandbox) or your approved business number
TWILIO_WHATSAPP_FROM=
# Order updates to customers (confirmed / shipped / out for delivery / delivered / cancelled):
# off | sms | whatsapp. In India, SMS needs DLT-registered templates and WhatsApp needs approved
# templates for messages the customer did not start, so leave this off until those are in place.
ORDER_NOTIFICATIONS=off
# Site address used in "track your order" links in messages
SITE_URL=https://www.tranzlife.in

# ---- MSG91 (alternative for sign-in codes, used only if Twilio is not set) ----
# Needs a DLT-registered OTP template. With no SMS provider set, customers cannot sign in
# (there is no test mode).
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
