{
  "name": "transzlife-static",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-dist.js",
    "preview": "vite preview",
    "gallery": "node scripts/gallery/build-gallery.mjs",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.js",
    "gemini-bot": "cd gemini-bot && npm start",
    "dev:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --watch-path=server server/index.js",
    "test:api": "node --test --test-concurrency=3 server/shop/shop.test.js server/admin/admin.test.js server/shop/twilio.test.js server/admin/catalog.test.js server/admin/phase3.test.js server/admin/phase4.test.js server/admin/tracking.test.js server/admin/reviews.test.js server/admin/offers.test.js server/admin/content.test.js server/admin/ops.test.js",
    "db": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/db/console.js",
    "admin:create": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/admin/create-staff.js",
    "twilio:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/shop/twilio-check.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@electric-sql/pglite": "^0.6.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^10.3.0",
    "@google/genai": "^3.6.1",
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.8",
    "lucide-react": "^1.77.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.4",
    "shadcn": "^4.23.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
